{
  "name": "scc-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "projects/*/frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "go:build": "go build ./...",
    "go:test": "go test ./..."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
